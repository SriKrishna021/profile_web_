import React, { useEffect, useRef, useState } from 'react';

const SKILLS = [
  { cat:'Frontend',       items:[{name:'React.js / Next.js',pct:92},{name:'HTML5 & CSS3',pct:95},{name:'JavaScript / TypeScript',pct:88},{name:'Tailwind CSS',pct:85}] },
  { cat:'Backend',        items:[{name:'Node.js / Express',pct:90},{name:'Python / Django',pct:78},{name:'REST API Design',pct:92},{name:'GraphQL',pct:72}] },
  { cat:'Database',       items:[{name:'PostgreSQL / MySQL',pct:88},{name:'MongoDB',pct:82},{name:'Redis',pct:70},{name:'Prisma / Sequelize',pct:80}] },
  { cat:'DevOps & Tools', items:[{name:'Docker / Kubernetes',pct:75},{name:'AWS / Vercel / Heroku',pct:80},{name:'Git & CI/CD',pct:90},{name:'Linux / Bash',pct:78}] },
];

export default function Skills() {
  const ref = useRef(null);
  const [animated, setAnimated] = useState(false);

  useEffect(() => {
    const obs = new IntersectionObserver(([e]) => { if (e.isIntersecting) setAnimated(true); }, { threshold: 0.2 });
    if (ref.current) obs.observe(ref.current);
    return () => obs.disconnect();
  }, []);

  return (
    <section id="skills" ref={ref} style={{ padding:'6rem 4rem', background:'var(--surface)' }}>
      <SectionHeader label="Expertise" title="Skills & Technologies" />
      <div style={{ display:'grid', gridTemplateColumns:'repeat(auto-fit,minmax(280px,1fr))', gap:1, background:'var(--border)' }}>
        {SKILLS.map(({ cat, items }) => (
          <div key={cat} style={{ background:'var(--bg)', padding:'2rem' }}>
            <div style={{ fontFamily:'var(--font-mono)', fontSize:'0.75rem', color:'var(--accent)', textTransform:'uppercase', letterSpacing:2, marginBottom:'1.5rem' }}>
              <span style={{ color:'var(--border)', marginRight:8 }}>//</span>{cat}
            </div>
            {items.map(({ name, pct }) => (
              <div key={name} style={{ marginBottom:'1rem' }}>
                <div style={{ display:'flex', justifyContent:'space-between', fontSize:'0.85rem', marginBottom:6 }}>
                  <span>{name}</span>
                  <span style={{ fontFamily:'var(--font-mono)', fontSize:'0.72rem', color:'var(--muted)' }}>{pct}%</span>
                </div>
                <div style={{ height:3, background:'var(--border)' }}>
                  <div style={{ height:'100%', background:'linear-gradient(90deg,var(--accent2),var(--accent))', width: animated ? `${pct}%` : '0%', transition:'width 1s ease' }} />
                </div>
              </div>
            ))}
          </div>
        ))}
      </div>
    </section>
  );
}

export function SectionHeader({ label, title }) {
  return (
    <div style={{ marginBottom:'3.5rem' }}>
      <div style={{ fontFamily:'var(--font-mono)', fontSize:'0.72rem', color:'var(--accent)', letterSpacing:3, textTransform:'uppercase', marginBottom:'.75rem' }}>{label}</div>
      <h2 style={{ fontFamily:'var(--font-display)', fontSize:'clamp(1.8rem,3vw,2.8rem)', fontWeight:700 }}>{title}</h2>
      <div style={{ width:60, height:2, background:'var(--accent)', marginTop:'1rem' }} />
    </div>
  );
}
